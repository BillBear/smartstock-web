COACH_UNIVERSE_REFRESH_SECONDS=1200
COACH_UNIVERSE_INTRADAY_REFRESH_SECONDS=90
COACH_UNIVERSE_MIN_AMOUNT_YI=0.5
COACH_UNIVERSE_MAX_ANALYZE_COUNT=240
COACH_UNIVERSE_INDUSTRY_CAP=8
COACH_UNIVERSE_MIN_PRICE=1.0

NEWS_REFRESH_SECONDS=900
NEWS_SYMBOL_REFRESH_SECONDS=1800
