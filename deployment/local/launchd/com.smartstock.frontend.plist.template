<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smartstock.frontend</string>
  <key>WorkingDirectory</key>
  <string>__SMARTSTOCK_HOME__/frontend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec npm run dev -- --host 127.0.0.1 --port 3601</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/frontend.log</string>
  <key>StandardErrorPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/frontend.err.log</string>
</dict>
</plist>
