<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smartstock.postgres</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SMARTSTOCK_HOME__/postgres/start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/launchd-postgres.log</string>
  <key>StandardErrorPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/launchd-postgres.err.log</string>
</dict>
</plist>
