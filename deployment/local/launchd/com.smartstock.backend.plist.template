<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smartstock.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SMARTSTOCK_HOME__/scripts/local/launchd-backend.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/backend.log</string>
  <key>StandardErrorPath</key>
  <string>__SMARTSTOCK_HOME__/runtime/logs/backend.err.log</string>
</dict>
</plist>
